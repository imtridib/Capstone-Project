# Rename this file to "secrets.toml" and place it inside a ".streamlit" folder
# next to app.py, i.e.:
#
#   your_project/
#     app.py
#     .streamlit/
#       secrets.toml   <-- this file, renamed
#
# Streamlit automatically loads it into st.secrets — no code changes needed.

